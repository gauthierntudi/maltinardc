# Cloudflare D1 — copier ce fichier vers .env puis renseigner les valeurs.
# Ne pas préfixer par NEXT_PUBLIC_ : le jeton ne doit pas partir dans le navigateur.
# Redémarrer `npm run dev` après toute modification.

# Tableau de bord Cloudflare, colonne de droite : Account ID
CLOUDFLARE_ACCOUNT_ID=

# My Profile → API Tokens → jeton avec la permission D1:Edit
CLOUDFLARE_API_TOKEN=

# Workers & Pages → D1 → la base → Settings → Database ID
CLOUDFLARE_D1_DATABASE_ID=

# Nom de la base, utile pour Wrangler. L'API HTTP utilise l'identifiant ci-dessus.
CLOUDFLARE_D1_DATABASE_NAME=maltina

# Mot de passe de l'espace admin (/admin)
ADMIN_PASSWORD=

# Unikron SMS — confirmation apres inscription (https://unikron.tech/api/v2/sms/send)
UNIKRON_APP_KEY=
# Expéditeur SMS (11 caractères max, ex. MALTINA)
UNIKRON_SENDER=MALTINA

# Après avoir rempli les variables ci-dessus :
# npm run db:migrate
